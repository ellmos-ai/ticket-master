{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ticket-master/session-results/v1",
  "title": "Session results projection v1",
  "type": "object",
  "required": [
    "schema",
    "session_id",
    "host",
    "revision",
    "updated_at",
    "events",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "ellmos.ticket.session-results.v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "created_at",
          "title",
          "summary",
          "status",
          "source",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "message",
              "system",
              "analysis",
              "ticket_result",
              "decision"
            ]
          },
          "details": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "label",
                "mime"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "mime": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "skills",
        "tokens",
        "agents"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "observed_at",
              "scope"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "observed_at",
              "scope"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "observed_at",
              "scope"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
