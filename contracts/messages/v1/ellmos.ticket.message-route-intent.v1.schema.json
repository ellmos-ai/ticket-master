{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ellmos:ticket:message-route-intent:v1",
  "title": "Metadata-only Messages-Line transport subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_intent", "message_id", "receipt_id", "origin_ref", "recipient_ref",
    "target_ref", "surface", "delivery_mode", "payload_ref", "payload_sha256",
    "idempotency_key"
  ],
  "properties": {
    "route_intent": {"const": "ellmos.ticket.message-route-intent.v1"},
    "message_id": {"type": "string", "pattern": "^M-[0-9]{8}-[1-9][0-9]{8}$"},
    "receipt_id": {"type": "string", "pattern": "^R-[0-9]{8}-[1-9][0-9]{8}$"},
    "origin_ref": {"$ref": "#/$defs/ref"},
    "recipient_ref": {"$ref": "#/$defs/ref"},
    "target_ref": {"$ref": "#/$defs/ref"},
    "surface": {"enum": ["ticket_master", "local_gui", "server_gui", "registered_server"]},
    "delivery_mode": {"enum": ["chat_start", "on_demand", "active_chat"]},
    "payload_ref": {"type": "string", "pattern": "^messages-line:M-[0-9]{8}-[1-9][0-9]{8}$"},
    "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?![A-Za-z]:/)[^\\u0000-\\u0020\\u007F\\\\]{1,256}$"}
  }
}
