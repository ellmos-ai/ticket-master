{
  "schema": "ellmos.module.v2",
  "id": "ticket-master",
  "display_name": "ticket-master",
  "category": "control",
  "kind": "workflow",
  "status": "active",
  "visibility": "public",
  "provides": [
    "control.tickets",
    "workflow.ticket-triage",
    "tickets.capture",
    "control.trithon-shadow",
    "tickets.inventory"
  ],
  "requires": [],
  "optional": [
    "tasks.default"
  ],
  "conflicts": [],
  "surfaces": [
    "library",
    "cli",
    "workflow"
  ],
  "state": {
    "ownership": "external",
    "location": "project"
  },
  "boundaries": {
    "network": "none",
    "data": "user-local",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/ellmos-ai/ticket-master"
  },
  "adapters": [
    {
      "type": "cli-wrapper",
      "id": "ocean-tickets-inventory",
      "target": "open-ocean:ocean.py tickets inventory",
      "status": "source-and-isolated-runtime-smoke-pass",
      "role": "read-only host adapter",
      "note": "Delegates to ticket_master_runtime.adapters.ocean and the shared inventory engine; an isolated OCEAN CLI smoke passed. No task or database access. BACH host CLI binding remains separate and unverified."
    }
  ],
  "roles": [
    {
      "id": "ticket-master",
      "label": "TICKET-MASTER",
      "prompt": "prompts/TICKET-MASTER.en.md",
      "request": "Start as TICKET-MASTER. Complete boot steps (a) through (d) and enter POSITION 0.",
      "modes": [],
      "providers": [
        "claude",
        "codex",
        "agy",
        "kimi"
      ],
      "starter": "starters/posix/ticket-master.sh"
    }
  ]
}
