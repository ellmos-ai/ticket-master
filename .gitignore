# Real config (only the .example is tracked)
config/ticket-master.config.json

# Real TICKET-WRITER (SIG-TU) config - site-specific, contains the operator's
# real area list and store paths (only the .example is tracked)
config/ticket-writer.config.json

# Real domains registry - generated from a local BACH install by
# lib/domains_generator.py (only the .example is tracked)
config/domains.json

# Real urgency matrix - site-specific, same pattern as domains.json
# (only the .example is tracked)
config/urgency.json

# Real knowledge-source map - site-specific, same pattern as domains.json
# (only the .example is tracked)
config/knowledge.json

# Local secrets and credentials
.env
.env.*
.pypirc
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials*.json
token*.json
secrets*.json
*password*.json
*.recovery-codes.txt
*recovery*codes*.txt
.npmrc
*.db
*.sqlite
*.sqlite3

# Runtime ticket files can contain private project details.
tickets/*.txt
!tickets/_logs/INTAKE-TRIAGE-LOG.txt
!tickets/_templates/TICKET.txt

# Ticket lifecycle directories — keep .gitkeep, ignore everything else
tickets/QUEUED/*
!tickets/QUEUED/.gitkeep
tickets/PENDING/*
!tickets/PENDING/.gitkeep
tickets/SOLVED/*
!tickets/SOLVED/.gitkeep
tickets/.USER/*
!tickets/.USER/.gitkeep

# Local intake log variant
tickets/_logs/INTAKE-TRIAGE-LOG.local.txt

